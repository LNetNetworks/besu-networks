[Unit]
Description=RotationValidator service
ConditionPathExists={{ besu_home | default('/root/lacchain') }}/rotation-validator/client/client
After=network.target

[Service]
Type=simple
User=root
Group=root
LimitNOFILE=1024

Restart=on-failure
RestartSec=10
startLimitIntervalSec=60

WorkingDirectory={{ besu_home | default('/root/lacchain') }}/rotation-validator/client
ExecStart={{ besu_home | default('/root/lacchain') }}/rotation-validator/client/client

[Install]
WantedBy=multi-user.target